APP_ENV=development
SECRET_KEY=change-this-in-production-use-scripts-gen-key-py
PASSCODE_ENCRYPTION_KEY=change-this-in-production-use-scripts-gen-key-py
DATABASE_URL=sqlite:///data/shop.db
BACKUP_DIR=backups
COOKIE_SECURE=false

# For Vercel, set these in Project Settings instead of committing secrets:
# APP_ENV=production
# SECRET_KEY=<unique random secret, at least 32 characters>
# PASSCODE_ENCRYPTION_KEY=<unique Fernet key from scripts/gen_key.py>
# DATABASE_URL=<managed PostgreSQL connection string, preferably pooled>
# COOKIE_SECURE=true
